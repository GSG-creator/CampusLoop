{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "clean": "node -e \"for (const path of ['dist', 'server.js']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test": "npm run test:legacy && npm run test:regression",
    "test:legacy": "tsx src/tests/verify_step1.ts && tsx src/tests/verify_step2.ts && tsx src/tests/verify_step3.ts && tsx src/tests/verify_loop_ai.ts",
    "test:regression": "tsx --test src/tests/*.test.ts src/tests/*.test.tsx",
    "gcp-build": "npm run build",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "react-test-renderer": "^19.0.1",
    "@types/react-test-renderer": "^19.0.0"
  }
}
