# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional server-only model override. The default is gemini-3.8-flash.
GEMINI_MODEL="gemini-3.8-flash"

# The same server serves the frontend and /api routes (development and production).
PORT=3000

# PORT above is for local use. Cloud Run supplies PORT at runtime.
# Do not upload .env; configure GEMINI_API_KEY in server-side Secrets.
